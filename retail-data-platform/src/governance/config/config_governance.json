{
    "fail_on_error": false,
    "table_comments": {
        "{catalog}.silver.customers": "Current customers from the SQL Server CRM (SCD Type 1)",
        "{catalog}.silver.customers_history": "Customer history (SCD Type 2): one row per version, is_current marks the latest",
        "{catalog}.silver.sales_orders": "Web-shop orders from Cosmos DB, one row per order",
        "{catalog}.silver.order_products": "Web-shop order lines, one row per order + product",
        "{catalog}.silver.promotions": "Promotions applied to web-shop orders",
        "{catalog}.silver.clicked_items": "Products a customer clicked before ordering",
        "{catalog}.silver.sales": "Physical-store sales from S3, one row per customer + product + date",
        "{catalog}.gold.dim_customer": "Customer dimension. customer_id = -1 is the Unknown member",
        "{catalog}.gold.dim_product": "Product dimension. product_id = 'UNKNOWN' is the Unknown member",
        "{catalog}.gold.dim_date": "Calendar dimension, one row per day. date_key = yyyyMMdd, -1 = Unknown",
        "{catalog}.gold.dim_order": "Order dimension, one row per web-shop order",
        "{catalog}.gold.fact_sales": "Online sales fact. Grain: one row per order line. total_amount = qty * unit_price * (1 - discount)",
        "{catalog}.gold.fact_pos_sales": "Store sales fact. Grain: one row per customer + product + date"
    },
    "column_comments": {
        "{catalog}.gold.fact_sales": {
            "total_amount": "qty * unit_price * (1 - discount), rounded to 2 decimals",
            "discount": "Fraction 0-1; 0 when no promotion"
        },
        "{catalog}.gold.dim_customer": {
            "customer_type": "Segment_<loyalty_segment>, Unknown when missing"
        }
    },
