{
    "table": "{catalog}.gold.fact_sales",
    "layer": "GOLD",
    "checks": [
        {
            "name": "fact_sales_not_empty",
            "type": "min_row_count",
            "threshold": 1,
            "severity": "error",
            "on_failure": "fail"
        },
        {
            "name": "order_number_not_null",
            "type": "not_null",
            "column": "order_number",
            "severity": "error",
            "on_failure": "fail"
        },
        {
            "name": "customer_id_not_null",
            "type": "not_null",
            "column": "customer_id",
            "severity": "error",
            "on_failure": "fail"
        },
        {
            "name": "product_id_not_null",
            "type": "not_null",
            "column": "product_id",
            "severity": "error",
            "on_failure": "fail"
        },
        {
            "name": "order_date_key_not_null",
            "type": "not_null",
            "column": "order_date_key",
            "severity": "error",
            "on_failure": "fail"
        },
        {
            "name": "qty_positive",
            "type": "range",
            "column": "qty",
            "min": 1,
            "severity": "error",
            "on_failure": "fail"
        },
        {
            "name": "unit_price_not_negative",
            "type": "range",
            "column": "unit_price",
            "min": 0,
            "severity": "error",
            "on_failure": "fail"
        },
        {
            "name": "discount_range",
            "type": "range",
            "column": "discount",
            "min": 0,
            "max": 1,
            "severity": "error",
            "on_failure": "fail"
        },
        {
            "name": "promo_quantity_not_negative",
            "type": "range",
            "column": "promo_quantity",
            "min": 0,
            "severity": "error",
            "on_failure": "fail"
        },
        {
            "name": "total_amount_not_negative",
            "type": "range",
            "column": "total_amount",
            "min": 0,
            "severity": "error",
            "on_failure": "fail"
        },
        {
            "name": "fact_grain_unique",
            "type": "unique",
            "columns": [
                "order_number",
                "product_id"
            ],
            "severity": "error",
            "on_failure": "fail"
        },
        {
            "name": "customer_id_fk_dim_customer",
            "type": "referential_integrity",
            "child_column": "customer_id",
            "parent_table": "{catalog}.gold.dim_customer",
            "parent_column": "customer_id",
            "severity": "error",
            "on_failure": "fail"
        },
        {
            "name": "product_id_fk_dim_product",
            "type": "referential_integrity",
            "child_column": "product_id",
            "parent_table": "{catalog}.gold.dim_product",
            "parent_column": "product_id",
            "severity": "error",
            "on_failure": "fail"
        },
        {
            "name": "order_date_key_fk_dim_date",
            "type": "referential_integrity",
            "child_column": "order_date_key",
            "parent_table": "{catalog}.gold.dim_date",
            "parent_column": "date_key",
            "severity": "error",
            "on_failure": "fail"
        },
        {
            "name": "order_number_fk_dim_order",
            "type": "referential_integrity",
            "child_column": "order_number",
            "parent_table": "{catalog}.gold.dim_order",
            "parent_column": "order_number",
            "severity": "error",
            "on_failure": "fail"
        },
        {
            "name": "total_amount_formula",
            "type": "expression",
            "expression": "abs(total_amount - round(qty * unit_price * (1 - discount), 2)) < 0.01",
            "severity": "error",
            "on_failure": "fail"
        },
        {
            "name": "fact_rows_match_order_products",
            "type": "reconciliation",
            "source_table": "{catalog}.silver.order_products",
            "source_aggregation": "count",
            "target_aggregation": "count",
            "tolerance": 0,
            "severity": "warn",
            "on_failure": "warn"
        },
        {
            "name": "customer_found_in_crm",
            "type": "expression",
            "expression": "customer_id <> -1",
            "severity": "warn",
            "on_failure": "warn"
        }
    ]
}